---
import Button from '../ui/Button.astro';
---

<header class="fixed top-0 left-0 w-full z-50 bg-black/80 backdrop-blur-md border-b border-white/10">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    <div class="flex items-center justify-between h-16 md:h-20">
      <a href="/" class="flex items-center transition-opacity hover:opacity-80" aria-label="Lumo, página inicial">
        <img src="/assets/logo.png" alt="Lumo" class="h-7 w-auto" width="96" height="28" />
      </a>
      <Button href="#lista" variant="primary" class="!px-4 !py-2.5 text-sm sm:!px-5">
        Entrar na lista de espera
      </Button>
    </div>
  </div>
</header>
