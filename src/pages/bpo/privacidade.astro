---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/ui/Section.astro';
import BpoHeader from '../../components/bpo/BpoHeader.astro';
import BpoFooter from '../../components/bpo/BpoFooter.astro';
import { BPO_CONTACT } from '../../config/bpo';
---

<Layout
  title="Política de Privacidade | Lumo BPO"
  description="Política de Privacidade do Lumo BPO (texto provisório)."
  loadEmailJs={false}
  noindex
>
  <BpoHeader />
  <div class="relative">
    <Section class="pt-28 pb-16 md:pt-36 md:pb-20">
      <div class="max-w-3xl">
        <p class="inline-block rounded border border-lumo-brand/50 bg-lumo-brand/10 px-3 py-1 text-xs font-medium uppercase tracking-wide text-lumo-brand">
          Texto provisório. Substituir antes do lançamento.
        </p>
        <h1 class="heading-md mt-6 text-white">Política de Privacidade (provisória)</h1>
        <div class="mt-8 space-y-6 text-base md:text-lg text-lumo-text-secondary leading-relaxed">
          <p>
            [PLACEHOLDER] Esta é uma página provisória do Lumo BPO. A Política de Privacidade definitiva ainda será publicada aqui.
          </p>
          <p>
            Enquanto isso, informamos que o formulário da lista de espera coleta nome, e-mail, WhatsApp, nome da empresa
            e a faixa de lançamentos por mês, apenas para avisar você sobre o lançamento do Lumo BPO.
          </p>
          <p>
            Dúvidas ou pedidos sobre seus dados:
            <a class="text-white hover:text-lumo-brand transition-colors" href={`mailto:${BPO_CONTACT.supportEmail}`}>{BPO_CONTACT.supportEmail}</a>
          </p>
          <p><a class="text-white hover:text-lumo-brand transition-colors" href="/bpo">Voltar para o Lumo BPO</a></p>
        </div>
      </div>
    </Section>
    <BpoFooter />
  </div>
</Layout>
